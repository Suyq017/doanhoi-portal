{
  "name": "doanhoi-system",
  "version": "1.0.0",
  "description": "Student Organization Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "dev:full": "npm run docker:up && npm run dev",
    "prod:deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1",
    "prod:deploy-server": "powershell -ExecutionPolicy Bypass -File deploy-server.ps1",
    "prod:up": "docker-compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:down": "docker-compose -f docker-compose.prod.yml down",
    "prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "prod:build": "docker-compose -f docker-compose.prod.yml --env-file .env.production build --no-cache",
    "prod:backend-only": "docker-compose -f docker-compose.prod.yml --env-file .env.production up -d postgres backend"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^7.0.2",
    "concurrently": "^8.2.2",
    "rollup": "^4.21.2",
    "typeorm-uml": "^1.6.5"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}