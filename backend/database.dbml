Enum "organizations_type_enum" {
  "doan_truong"
  "doan_co_so"
  "chi_doan"
  "hoi_sinh_vien_truong"
  "lien_chi_hoi"
  "chi_hoi"
  "clb_truong"
  "clb_khoa"
}

Enum "user_organizations_role_enum" {
  "member"
  "admin"
  "super_admin"
}

Enum "users_membershipstatus_enum" {
  "doan_vien"
  "hoi_vien"
  "both"
  "none"
}

Enum "users_usertype_enum" {
  "student"
  "staff"
}

Enum "users_authprovider_enum" {
  "local"
  "google"
}

Enum "permissions_context_enum" {
  "system"
  "organization"
}

Table "departments" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "name" varchar [not null]
  "code" varchar
  "description" varchar
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "classes" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "name" varchar [not null]
  "year" int4
  "departmentId" uuid
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "users" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "code" varchar [unique, not null]
  "familyName" varchar [not null]
  "givenName" varchar [not null]
  "email" varchar [unique, not null]
  "phone" varchar [not null]
  "password" varchar
  "googleId" varchar
  "authProvider" users_authprovider_enum [not null, default: 'local']
  "isActive" bool [not null, default: true]
  "lastLogin" timestamp
  "ctxh_days" decimal(5,1) [note: 'Tổng số ngày CTXH hiện tại']
  "ctxh_days_old_system" decimal(5,1) [note: 'Số ngày CTXH từ hệ thống cũ']
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "user_organizations" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "userId" uuid [not null]
  "organizationId" uuid [not null]
  "role" user_organizations_role_enum [not null, default: 'member']
  "isActive" bool [not null, default: true]
  "joinedAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "organizations" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "name" varchar [not null]
  "description" varchar
  "type" organizations_type_enum [not null]
  "code" varchar
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
  "parentId" uuid
}

Table "permissions" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "code" varchar [unique, not null]
  "name" varchar [not null]
  "description" varchar
  "category" varchar [not null]
  "context" permissions_context_enum [not null, default: 'organization']
  "isActive" bool [not null, default: true]
  "sortOrder" int4 [not null, default: 0]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "roles" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "name" varchar [unique, not null]
  "displayName" varchar [not null]
  "description" varchar
  "isSystemRole" bool [not null, default: false]
  "isActive" bool [not null, default: true]
  "createdAt" timestamp [not null, default: `now()`]
  "updatedAt" timestamp [not null, default: `now()`]
}

Table "role_permissions" {
  "roleId" uuid [not null]
  "permissionId" uuid [not null]

  Indexes {
    (roleId, permissionId) [pk]
  }
}

Table "user_roles" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "userId" uuid [not null]
  "roleId" uuid [not null]
  "organizationId" uuid
  "isActive" bool [not null, default: true]
  "assignedAt" timestamp [not null, default: `now()`]

  Indexes {
    (userId, roleId, organizationId) [unique]
  }
}

Table "organizations_closure" {
  "id_ancestor" uuid [not null]
  "id_descendant" uuid [not null]

  Indexes {
    (id_ancestor, id_descendant) [type: btree, name: "PK_5eac0652945ed6ffbec83414215"]
    id_ancestor [type: btree, name: "IDX_2fa2dfc7daa3b6730231351107"]
    id_descendant [type: btree, name: "IDX_58bbb42b8f3a85417296bc398e"]
  }
}

