{
  "name": "doanhoi-backend",
  "version": "0.0.1",
  "description": "Backend API for Đoàn Hội Sinh viên management system",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:core": "jest --testPathIgnorePatterns=ctxh-chat",
    "test:core:cov": "jest --coverage --testPathIgnorePatterns=ctxh-chat",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:phase2": "jest --testPathPattern=ctxh-chat",
    "test:phase2:unit": "jest --testPathPattern=ctxh-chat.*spec\\.ts$",
    "test:phase2:e2e": "jest --testPathPattern=ctxh-chat-e2e",
    "test:phase2:perf": "ts-node test/performance-benchmark.ts",
    "test:phase2:all": "npm run test:phase2:unit && npm run test:phase2:e2e && npm run test:phase2:perf",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:create-schema": "ts-node src/database/create-schema.ts",
    "db:reset": "ts-node src/database/reset-database.ts && npm run seed",
    "db:drop": "ts-node src/database/reset-database.ts",
    "seed": "ts-node src/database/seeds/index.ts",
    "seed:permissions": "ts-node -e \"import('./src/database/seeds/permissions.seed').then(m => m.seedPermissions(require('./src/database/seeds/dataSource')))\"",
    "seed:roles": "ts-node -e \"import('./src/database/seeds/roles.seed').then(m => m.seedRoles(require('./src/database/seeds/dataSource')))\"",
    "seed:users": "ts-node -e \"import('./src/database/seeds/default-users.seed').then(m => m.seedDefaultUsers(require('./src/database/seeds/dataSource')))\"",
    "seed:ctxh-activities": "docker cp scripts/insert-ctxh-activities.sql doanhoi-postgres:/tmp/insert-ctxh-activities.sql && docker exec doanhoi-postgres psql -U postgres -d doanhoi -f /tmp/insert-ctxh-activities.sql",
    "update:permissions": "ts-node src/database/scripts/update-permissions.ts",
    "update:super-admin": "ts-node src/database/scripts/update-super-admin-role.ts",
    "verify:super-admin": "ts-node src/database/scripts/verify-super-admin-permissions.ts",
    "migrate:aws-s3": "ts-node src/database/migrations/create-aws-s3-configs-table.ts",
    "migrate:ctxh-updates": "ts-node src/database/migrations/add-ctxh-columns-and-update-activity-dates.ts",
    "migrate:ctxh-registration": "node scripts/run-ctxh-registration-migrations.js",
    "pgvector:setup": "docker cp scripts/pgvector-setup.sql doanhoi-postgres:/tmp/pgvector-setup.sql && docker exec doanhoi-postgres psql -U postgres -d doanhoi -f /tmp/pgvector-setup.sql",
    "rag:test-connections": "node scripts/test-rag-connections.js",
    "rag:ingest": "curl -X POST http://localhost:9200/api/ctxh-chat/ingestion/full -H \"Content-Type: application/json\"",
    "rag:ingest-incremental": "curl -X POST http://localhost:9200/api/ctxh-chat/ingestion/incremental -H \"Content-Type: application/json\"",
    "rag:stats": "curl -X GET http://localhost:9200/api/ctxh-chat/ingestion/stats",
    "rag:health": "curl -X GET http://localhost:9200/api/ctxh-chat/health",
    "rag:test": "npm run test -- --testPathPattern=rag",
    "ctxh:clear-vectors": "node scripts/clear-ctxh-embeddings.js",
    "check:models": "ts-node -r tsconfig-paths/register src/scripts/check-model-status.ts",
    "migrate:embeddings": "ts-node -r tsconfig-paths/register src/scripts/migrate-embeddings.ts",
    "generate:testset": "ts-node scripts/generate-testset.ts",
    "generate:sql": "ts-node scripts/excel-to-sql.ts",
    "models:health": "curl -X GET http://localhost:9200/api/ctxh-chat/health/models"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@google/genai": "^1.33.0",
    "@langchain/community": "^1.0.4",
    "@langchain/core": "^1.1.8",
    "@langchain/google-genai": "^2.1.13",
    "@langchain/ollama": "^1.2.1",
    "@langchain/openai": "^1.1.2",
    "@langchain/textsplitters": "^1.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/typeorm": "^10.0.0",
    "@payos/node": "^1.0.10",
    "@types/ioredis": "^4.28.10",
    "@types/multer": "^1.4.13",
    "@types/pg": "^8.15.6",
    "@types/redis": "^4.0.10",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docxtemplater": "^3.67.4",
    "form-data": "^4.0.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.0.6",
    "multer": "^2.0.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.104.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "pizzip": "^3.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "tiktoken": "^1.0.22",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.17",
    "@types/graceful-fs": "^4.1.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
