# ─── Chatbot API ─────────────────────────────────────────────────────────────
# URL của NestJS backend (thường là localhost khi chạy local)
EVAL_BASE_URL=http://localhost:

# ─── Xác thực (chọn 1 trong 2 cách) ────────────────────────────────────────┐
# Cách 1 (đơn giản hơn): Cung cấp JWT token trực tiếp                        │
# Lấy token: đăng nhập vào app → F12 → Application → LocalStorage → token   │
EVAL_JWT_TOKEN=

# Cách 2: Cung cấp email/password, script tự đăng nhập                       │
EVAL_EMAIL=
EVAL_PASSWORD=
# ─────────────────────────────────────────────────────────────────────────────┘

# ─── Gemini API (dùng làm LLM judge trong RAGAS) ────────────────────────────
# Dùng cùng key với backend (đã có sẵn trong backend/.env)
GEMINI_API_KEY=
# ─── Tuning ──────────────────────────────────────────────────────────────────
# Delay giữa các request đến chatbot API (ms) — tránh rate limit
EVAL_DELAY_MS=700
