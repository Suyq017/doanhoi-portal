# ─── Chatbot API ─────────────────────────────────────────────────────────────
# URL của NestJS backend (thường là localhost khi chạy local)
EVAL_BASE_URL=http://localhost:

# ─── Xác thực ────────────────────────────────────────────────────────────────
# Cung cấp JWT token trực tiếp
# Lấy token: đăng nhập vào app → F12 → Application → LocalStorage → token
EVAL_JWT_TOKEN=

# Token riêng cho student (--mode intent / all) — fallback sang EVAL_JWT_TOKEN nếu bỏ trống
EVAL_STUDENT_TOKEN=

# Token staff (dùng trong evaluate_staff.py)
EVAL_STAFF_TOKEN=
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM Judge Toggle ───────────────────────────────────────────────────────
# Set true để dùng Ollama làm LLM judge thay cho Gemini
USE_LOCAL_MODEL_LLM=false

# ─── Gemini API (dùng khi USE_LOCAL_MODEL_LLM=false) ────────────────────────
# Dùng cùng key với backend (đã có sẵn trong backend/.env)
GEMINI_API_KEY=

# ─── Ollama Configuration (dùng khi USE_LOCAL_MODEL_LLM=true) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSION=1024

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Delay giữa các request đến chatbot API (ms) — tránh rate limit
EVAL_DELAY_MS=700
