# Production-only Dockerfile - uses pre-built dist folder
FROM nginx:alpine

# Update packages để fix vulnerabilities
RUN apk update && apk upgrade && apk add --no-cache curl && rm -rf /var/cache/apk/*

# Copy built static files (assuming dist is already built by CI)
COPY dist/ /usr/share/nginx/html/

# Copy custom nginx config if needed (optional)
# COPY nginx.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
